# Stage 1: Build & Package Requirements
FROM python:3.10-slim AS builder
WORKDIR /app
RUN apt-get update && apt-get install -y --no-install-recommends gcc g++ && rm -rf /var/lib/apt/lists/*
COPY requirements/serve.txt .
RUN pip install --no-cache-dir --user -r serve.txt

# Stage 2: Lean serving runtime footprint
FROM python:3.10-slim AS runner
WORKDIR /app
COPY --from=builder /root/.local /root/.local
COPY src/ /app/src/

ENV PATH=/root/.local/bin:$PATH
ENV PYTHONPATH=/app
ENV MODEL_PATH=/mnt/models/model.pth

EXPOSE 8000
ENTRYPOINT ["uvicorn", "src/serve.py:app", "--host", "0.0.0.0", "--port", "8000"]
